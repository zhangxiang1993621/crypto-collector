# ══════════════ 数据库（Supabase PostgreSQL 直连）══════════════
# 二选一：方式1 完整连接串（推荐，优先级最高）
# 方式2 仅密码 + 下面的 SUPABASE_URL
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_DB_PASSWORD=your_db_password_here
# 仅少数使用 Supabase SDK 的脚本需要（如 task_manager/create_bots.py）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ══════════════ 外部 API ══════════════
COINCAP_API_KEY=your_coincap_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ══════════════ 发帖配置 ══════════════
POSTS_AUTHOR_USERNAME=indoAdmin

# 分类名必须与 Supabase categories 表中的记录一致
POSTS_CATEGORY_NAME=news                 # 币安新闻 / FIFA 赛程
FIFA_CATEGORY_NAME=Sports Talk           # 体育 / 世界杯 / 羽毛球
INDO_CATEGORY_NAME=Indo Street           # 印尼热点
PINTU_CATEGORY_NAME=news                 # Pintu（脚本内默认 Hot Tokens）
TOKOCRYPTO_CATEGORY_NAME=news            # Tokocrypto（脚本内默认 Hot Tokens）
INDODAX_CATEGORY_NAME=news               # Indodax（脚本内默认 Hot Tokens）
OSL_CATEGORY_NAME=news                   # OSL（脚本内默认 Hot Tokens）
MOBEE_CATEGORY_NAME=news                 # Mobee（脚本内默认 Hot Tokens）
BITGET_CATEGORY_NAME=news                # Bitget（脚本内默认 Hot Tokens）
OKX_CATEGORY_NAME=news                   # OKX（脚本内默认 Hot Tokens）
ESPORTS_CATEGORY_NAME=E-Sports           # 印尼电竞
HOT_TOKENS_CATEGORY_NAME=Hot Tokens      # AI 日报 / 空投福利
